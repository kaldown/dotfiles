{
  "skillListingBudgetFraction": 0.02,
  "env": {
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1",
    "CLAUDE_AUTOCOMPACT_PCT_OVERRIDE": "95",
    "CLAUDE_CODE_NO_FLICKER": "1",
    "CLAUDE_CODE_DISABLE_ADAPTIVE_THINKING": "1"
  },
  "attribution": {
    "commit": "",
    "pr": ""
  },
  "permissions": {
    "allow": [
      "Read(./.claude/**)",
      "Read(~/.claude/plugins/**)",
      "Bash(pnpm:*)",
      "Bash(npm:*)",
      "Bash(npx:*)",
      "Bash(corepack:*)",
      "Bash(tsc:*)",
      "Bash(tsx:*)",
      "Bash(vite:*)",
      "Bash(vitest:*)",
      "Bash(node:*)",
      "Bash(xattr -l *)"
    ],
    "deny": [],
    "ask": [
      "Bash(curl * | bash*)",
      "Bash(curl * | sh*)",
      "Bash(curl * | zsh*)",
      "Bash(wget * | bash*)",
      "Bash(wget * | sh*)",
      "Bash(wget * | zsh*)",
      "Bash(git push:*)",
      "Bash(git checkout:*)",
      "Bash(git rebase:*)",
      "Bash(git clone:*)",
      "Bash(git stash:*)",
      "Bash(git restore:*)",
      "Bash(git reset:*)",
      "Bash(git clean:*)",
      "Bash(git revert:*)",
      "Bash(git branch -D:*)",
      "Bash(git branch -d:*)",
      "Bash(git branch --delete:*)",
      "Bash(git worktree remove:*)",
      "Bash(rm:*)",
      "Bash(docker rm:*)",
      "Bash(docker volume rm:*)",
      "Bash(docker container rm:*)",
      "Bash(docker network rm:*)",
      "Bash(docker image rm:*)",
      "Bash(docker buildx rm:*)",
      "Bash(docker buildx prune:*)",
      "Bash(docker builder prune:*)",
      "Bash(docker container prune:*)",
      "Bash(docker image prune:*)",
      "Bash(docker volume prune:*)",
      "Bash(docker network prune:*)",
      "Bash(docker system prune:*)",
      "Bash(xattr:*)",
      "Bash(chmod:*)",
      "Bash(brew:*)",
      "KillShell"
    ],
    "respectGitignore": true
  },
  "hooks": {
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/statusline-hooks.sh agent-start",
            "async": true
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/statusline-hooks.sh agent-stop",
            "async": true
          }
        ]
      }
    ],
    "TaskCreated": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/statusline-hooks.sh task-create",
            "async": true
          }
        ]
      }
    ],
    "TaskCompleted": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/statusline-hooks.sh task-complete",
            "async": true
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/statusline-hooks.sh cleanup",
            "async": true
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "bash ~/.claude/hooks/statusline-command.sh"
  },
  "enabledPlugins": {
    "context7@claude-plugins-official": true,
    "ralph-loop@claude-plugins-official": false,
    "feature-dev@claude-plugins-official": true,
    "python-development@claude-code-workflows": true,
    "debugging-toolkit@claude-code-workflows": false,
    "documentation-generation@claude-code-workflows": false,
    "pyright-lsp@claude-plugins-official": true,
    "code-documentation@claude-code-workflows": false,
    "code-refactoring@claude-code-workflows": false,
    "code-review@claude-plugins-official": true,
    "kubernetes-operations@claude-code-workflows": false,
    "rust-analyzer-lsp@claude-plugins-official": false,
    "c4-architecture@claude-code-workflows": false,
    "cloud-infrastructure@claude-code-workflows": false,
    "frontend-design@claude-plugins-official": true,
    "hookify@claude-plugins-official": false,
    "code-simplifier@claude-plugins-official": true,
    "codebase-cleanup@claude-code-workflows": false,
    "developer-essentials@claude-code-workflows": false,
    "error-debugging@claude-code-workflows": false,
    "error-diagnostics@claude-code-workflows": false,
    "tdd-workflows@claude-code-workflows": false,
    "unit-testing@claude-code-workflows": false,
    "cicd-automation@claude-code-workflows": false,
    "superpowers@claude-plugins-official": true,
    "claude-md-management@claude-plugins-official": true,
    "claude-code-setup@claude-plugins-official": false,
    "gitlab@claude-plugins-official": false,
    "skill-creator@claude-plugins-official": true,
    "explanatory-output-style@claude-plugins-official": false,
    "learning-output-style@claude-plugins-official": false,
    "github@claude-plugins-official": false,
    "playwright@claude-plugins-official": false,
    "typescript-lsp@claude-plugins-official": false,
    "security-guidance@claude-plugins-official": false,
    "commit-commands@claude-plugins-official": true,
    "serena@claude-plugins-official": false,
    "pr-review-toolkit@claude-plugins-official": false,
    "plugin-dev@claude-plugins-official": false,
    "slack@claude-plugins-official": false,
    "playground@claude-plugins-official": false,
    "microsoft-docs@claude-plugins-official": false,
    "mintlify@claude-plugins-official": false,
    "atomic-agents@claude-plugins-official": false,
    "telegram@claude-plugins-official": false,
    "remember@claude-plugins-official": true,
    "circleback@claude-plugins-official": false,
    "sourcegraph@claude-plugins-official": false,
    "sentry@claude-plugins-official": false,
    "claude-mem@thedotmack": true,
    "differential-review@trailofbits": true,
    "insecure-defaults@trailofbits": true,
    "supply-chain-risk-auditor@trailofbits": true
  },
  "extraKnownMarketplaces": {
    "trailofbits": {
      "source": {
        "source": "github",
        "repo": "trailofbits/skills"
      }
    }
  },
  "sandbox": {
    "enabled": true,
    "autoAllowBashIfSandboxed": true,
    "allowUnsandboxedCommands": true,
    "network": {
      "allowedDomains": [
        "github.com",
        "pypi.org",
        "gitlab.com",
        "raw.githubusercontent.com"
      ],
      "allowUnixSockets": [
        "~/.docker/run/docker.sock"
      ]
    },
    "enableWeakerNetworkIsolation": true,
    "excludedCommands": [
      "docker:*",
      "docker-compose:*",
      "gh:*",
      "glab:*",
      "gcloud:*"
    ],
    "deniedDirectories": [
      "~/.ssh",
      "~/.pgpass",
      "~/.aws",
      "~/.config",
      "~/.gnupg",
      "~/.bashrc",
      "/etc",
      "/usr"
    ]
  },
  "alwaysThinkingEnabled": true,
  "effortLevel": "xhigh",
  "promptSuggestionEnabled": false,
  "plansDirectory": ".claude/plans",
  "skipWorkflowUsageWarning": true,
  "verbose": true,
  "autoCompactEnabled": false,
  "teammateMode": "tmux",
  "remoteControlAtStartup": false,
  "agentPushNotifEnabled": true
}
