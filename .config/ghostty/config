# ═══════════════════════════════════════════════════════════════════════════
# GHOSTTY CONFIGURATION - Catppuccin Macchiato + SAND Keybindings
# ═══════════════════════════════════════════════════════════════════════════
# File: ~/.config/ghostty/config
# Reload: Cmd+Shift+, (macOS)
# SAND: Split, Across, Navigate, Destroy
# Based on: github.com/davila7 (adapted for Claude Code teammate mode)

# ───────────────────────────────────────────────────────────────────────────
# TYPOGRAPHY
# ───────────────────────────────────────────────────────────────────────────

font-family = JetBrainsMono Nerd Font
font-size = 14
font-thicken = true
adjust-cell-height = 2

# ───────────────────────────────────────────────────────────────────────────
# THEME & APPEARANCE
# ───────────────────────────────────────────────────────────────────────────

# Catppuccin Macchiato (dark) / Latte (light) - auto-switches with macOS
theme = light:Catppuccin Latte,dark:Catppuccin Macchiato

# Window
macos-titlebar-style = transparent
window-padding-x = 5
window-padding-y = 5
window-save-state = always
window-theme = auto

# Cursor
cursor-style = bar
cursor-style-blink = true

# ───────────────────────────────────────────────────────────────────────────
# INPUT & MOUSE
# ───────────────────────────────────────────────────────────────────────────

mouse-hide-while-typing = true
copy-on-select = clipboard

# ───────────────────────────────────────────────────────────────────────────
# QUICK TERMINAL (Quake-style dropdown: Ctrl+`)
# ───────────────────────────────────────────────────────────────────────────

quick-terminal-position = top
quick-terminal-screen = mouse
quick-terminal-autohide = true
quick-terminal-animation-duration = 0.15

# ───────────────────────────────────────────────────────────────────────────
# SECURITY
# ───────────────────────────────────────────────────────────────────────────

clipboard-paste-protection = true
clipboard-paste-bracketed-safe = true

# ───────────────────────────────────────────────────────────────────────────
# SHELL INTEGRATION
# ───────────────────────────────────────────────────────────────────────────

shell-integration = detect

# ───────────────────────────────────────────────────────────────────────────
# KEYBINDINGS — SAND SYSTEM
# ───────────────────────────────────────────────────────────────────────────
# S - Split:    Create new panels
# A - Across:   Move between tabs
# N - Navigate: Jump between split panels
# D - Destroy:  Close panels and tabs

# S - Split
keybind = cmd+d=new_split:right
keybind = cmd+shift+d=new_split:down

# A - Across (tabs)
keybind = cmd+t=new_tab
keybind = cmd+shift+left=previous_tab
keybind = cmd+shift+right=next_tab

# N - Navigate (splits)
keybind = cmd+alt+left=goto_split:left
keybind = cmd+alt+right=goto_split:right
keybind = cmd+alt+up=goto_split:top
keybind = cmd+alt+down=goto_split:bottom
keybind = cmd+shift+e=equalize_splits
keybind = cmd+shift+f=toggle_split_zoom

# D - Destroy
keybind = cmd+w=close_surface

# ───────────────────────────────────────────────────────────────────────────
# FIXTERMS / KKP OVERRIDES
# ───────────────────────────────────────────────────────────────────────────
# Force traditional encoding for critical terminal signals regardless of
# kitty keyboard protocol state. Prevents leaked KKP from breaking shell
# after programs (e.g., Claude Code) exit without popping the protocol.
# See: https://github.com/ghostty-org/ghostty/discussions/5071

keybind = ctrl+d=text:\x04
keybind = ctrl+c=text:\x03
keybind = ctrl+z=text:\x1a

# ───────────────────────────────────────────────────────────────────────────
# UTILITY KEYBINDINGS
# ───────────────────────────────────────────────────────────────────────────

# Font size
keybind = cmd+plus=increase_font_size:1
keybind = cmd+minus=decrease_font_size:1
keybind = cmd+zero=reset_font_size

# Quick terminal global hotkey
keybind = global:ctrl+grave_accent=toggle_quick_terminal

# Reload config
keybind = cmd+shift+comma=reload_config

# ───────────────────────────────────────────────────────────────────────────
# PERFORMANCE
# ───────────────────────────────────────────────────────────────────────────

# 25MB scrollback for long Claude Code sessions
scrollback-limit = 25000000
