<?xml version="1.0" encoding="UTF-8"?>
<!--
  local.claude-hang-watchdog
  ─────────────────────────────────────────────────────────────────────────────
  launchd agent that runs ~/.claude/hooks/hang-watchdog.sh in single-scan
  mode every 30 seconds (see ProgramArguments below). The watchdog kills
  any pytest/playwright process older than 180s
  — a safety net for Claude Code subagents that wedge on hung test runners.

  INSTALL:
    cp <this-file> ~/Library/LaunchAgents/
    launchctl load ~/Library/LaunchAgents/local.claude-hang-watchdog.plist

  STATUS:    launchctl list | grep local.claude-hang-watchdog
  STOP:      launchctl unload ~/Library/LaunchAgents/local.claude-hang-watchdog.plist
  KILL LOG:  tail -f ~/.claude/watchdog.log

  PAIR: ~/.claude/hooks/timeout-guard.sh — Claude-side PreToolUse hook
        that prevents most hang-prone commands at the source.

  PORTABILITY NOTE:
    launchd does not expand ~ or env vars in ProgramArguments. To avoid
    hard-coding /Users/<name>/, this plist invokes /bin/sh which does the
    expansion at runtime. stdout/stderr are appended to the watchdog log
    by the same shell, so StandardOutPath/StandardErrorPath are unused.
-->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>local.claude-hang-watchdog</string>
    <key>ProgramArguments</key>
    <array>
        <string>/bin/sh</string>
        <string>-c</string>
        <string>exec "$HOME/.claude/hooks/hang-watchdog.sh" --once >> "$HOME/.claude/watchdog.log" 2>&amp;1</string>
    </array>
    <key>StartInterval</key>
    <integer>30</integer>
    <key>RunAtLoad</key>
    <true/>
    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
    </dict>
</dict>
</plist>
