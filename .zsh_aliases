# ==============================================================================
# ZSH ALIASES - kaldown
# ==============================================================================
# Philosophy: Don't replace core POSIX tools (find/grep/cat) - scripts expect them.
# Use short aliases for interactive use. Modern replacements for monitoring tools
# are safe since scripts rarely use them.
#
# NOTE: This file is not sourced when CLAUDECODE=1 (see .zshrc)
# ==============================================================================

# ------------------------------------------------------------------------------
# Claude Code
# ------------------------------------------------------------------------------
# Claude Code security wrapper
# Auto-injects hookify rules to block file operations outside project directory
# Templates: ~/.claude/templates/ | Script: ~/.claude/scripts/claude-hooks-injector.sh
#alias claude='~/.claude/scripts/claude-wrapper.sh && command claude' 

# ------------------------------------------------------------------------------
# SAFE REPLACEMENTS (compatible args or rarely used by scripts)
# ------------------------------------------------------------------------------

# ls → eza (safe: basic flags are compatible)
if (( ${+commands[eza]} )); then
  alias ls='eza --icons'
  alias la='eza --icons -a'
  alias ll='eza --icons -la'
  alias lt='eza --icons --tree'
  alias lg='eza --icons -la --git'
  alias l1='eza --icons -1'
  alias lm='eza --icons -la --sort=modified'
  alias lsize='eza --icons -la --sort=size'
fi

# cat -> bat
(( ${+commands[bat]} )) && alias cat='bat --paging=never'

# System monitoring (safe: scripts don't typically use these interactively)
(( ${+commands[btop]} )) && alias top='btop'
(( ${+commands[btop]} )) && alias htop='btop'
(( ${+commands[procs]} )) && alias ps='procs'

# Disk usage (safe: rarely used programmatically)
(( ${+commands[duf]} )) && alias df='duf'
(( ${+commands[dust]} )) && alias du='dust'
(( ${+commands[ncdu]} )) && alias duc='ncdu'    # disk usage curses

# Network (safe alternatives)
(( ${+commands[gping]} )) && alias ping='gping'
(( ${+commands[dog]} )) && alias dig='dog'
#(( ${+commands[xh]} )) && alias curl='xh'
#(( ${+commands[curlie]} )) && alias curl='curlie'  # curl with colors

# ------------------------------------------------------------------------------
# EDITOR
# ------------------------------------------------------------------------------

alias vim='lvim'
alias v='lvim'
alias vi='lvim'
alias e='$EDITOR'

# Quick edit configs
alias zshrc='$EDITOR ~/.zshrc'
alias aliases='$EDITOR ~/.zsh_aliases'
alias vimrc='$EDITOR ~/.config/lvim/config.lua'
alias wezrc='$EDITOR ~/.config/wezterm/wezterm.lua'

# ------------------------------------------------------------------------------
# NAVIGATION
# ------------------------------------------------------------------------------

alias ..='cd ..'
alias ...='cd ../..'
alias -- -='cd -'

# Quick dirs
alias downloads='cd ~/Downloads'
alias projects='cd ~/Projects'
alias desktop='cd ~/Desktop'

# ------------------------------------------------------------------------------
# SAFETY
# ------------------------------------------------------------------------------

alias cp='cp -i'
alias mv='mv -i'
alias rm='rm -i'
alias mkdir='mkdir -pv'
alias ln='ln -iv'

# ------------------------------------------------------------------------------
# GIT
# ------------------------------------------------------------------------------

# DOTFILES MANAGEMENT (bare git repo)
# Manage dotfiles with: config status, config add, config commit, config push
alias dotconfig='/usr/bin/git --git-dir=$HOME/.dotfiles/ --work-tree=$HOME'

# lazygit
(( ${+commands[lazygit]} )) && alias lzg='lazygit'

# ------------------------------------------------------------------------------
# DOCKER
# ------------------------------------------------------------------------------

# lazydocker
(( ${+commands[lazydocker]} )) && alias lzd='lazydocker'

# replaced by sbx
# Sync plugins from host to Docker sandbox (fixes paths, scope, orphan markers)
# sync-claude-plugins() {
#     ~/.claude/scripts/sandbox/sync-plugins.sh "$@"
# }

