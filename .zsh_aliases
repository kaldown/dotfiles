# alias claude-sandbox='docker sandbox run -v docker-claude-plugins:/home/agent/.claude/plugins claude'

# ------------------------------------------------------------------------------
# PYTHON / UV
# ------------------------------------------------------------------------------

alias venv='uv venv'
alias activate='source .venv/bin/activate'
alias ipython='uv run --with "catppuccin[pygments]" --with ipython -- ipython'

# ------------------------------------------------------------------------------
# DEV TOOLS
# ------------------------------------------------------------------------------

# Code stats
(( ${+commands[tokei]} )) && alias loc='tokei'
(( ${+commands[scc]} )) && alias scc='scc'

# Benchmarking: Use 'bench' alias instead of overriding 'time'
# (hyperfine and time have incompatible syntax)
(( ${+commands[hyperfine]} )) && alias bench='hyperfine'

# JSON/YAML
(( ${+commands[jq]} )) && alias jq='jq'
(( ${+commands[yq]} )) && alias yq='yq'

# Text processing
(( ${+commands[sd]} )) && alias sed='sd'
(( ${+commands[choose]} )) && alias cut='choose'
(( ${+commands[grex]} )) && alias regex='grex'

# Help
(( ${+commands[tldr]} )) && alias help='tldr'
(( ${+commands[tldr]} )) && alias '?'='tldr'

# ------------------------------------------------------------------------------
# MISC UTILITIES
# ------------------------------------------------------------------------------

alias fzf='fzf -m'
alias h='history'
alias hg='history | rg'
alias j='jobs -l'
alias path='echo $PATH | tr ":" "\n"'
alias reload='exec zsh'
alias cls='clear'
alias c='clear'
alias q='exit'

# ------------------------------------------------------------------------------
# Clipboard (macOS)
# ------------------------------------------------------------------------------

alias y='cb copy'                    # yank
alias p='cb paste'                   # paste  
alias yl='fc -ln -1 | cb copy'       # yank last command

# IP addresses
alias myip='curl -s https://ipinfo.io/ip'
alias localip='ipconfig getifaddr en0'
alias ips="ifconfig | grep 'inet ' | grep -v 127.0.0.1 | awk '{print \$2}'"

# macOS specific
alias flushdns='sudo dscacheutil -flushcache && sudo killall -HUP mDNSResponder'
alias showfiles='defaults write com.apple.finder AppleShowAllFiles YES && killall Finder'
alias hidefiles='defaults write com.apple.finder AppleShowAllFiles NO && killall Finder'
alias afk='pmset displaysleepnow'          # lock screen

# Timestamps
alias now='date +"%Y-%m-%d %H:%M:%S"'
alias nowdate='date +"%Y-%m-%d"'
alias nowtime='date +"%H:%M:%S"'
alias epoch='date +%s'

# ------------------------------------------------------------------------------
# FUNCTIONS
# ------------------------------------------------------------------------------

# Extract any archive
extract() {
  if [[ -f "$1" ]]; then
    case "$1" in
      *.tar.bz2)   tar xjf "$1"     ;;
      *.tar.gz)    tar xzf "$1"     ;;
      *.tar.xz)    tar xJf "$1"     ;;
      *.bz2)       bunzip2 "$1"     ;;
      *.gz)        gunzip "$1"      ;;
      *.tar)       tar xf "$1"      ;;
      *.tbz2)      tar xjf "$1"     ;;
      *.tgz)       tar xzf "$1"     ;;
      *.zip)       unzip "$1"       ;;
      *.Z)         uncompress "$1"  ;;
      *.7z)        7z x "$1"        ;;
      *.rar)       unrar x "$1"     ;;
      *)           echo "'$1' cannot be extracted" ;;
    esac
  else
    echo "'$1' is not a valid file"
  fi
}

# Quick backup
bakup() { cp "$1" "$1.bak.$(date +%Y%m%d_%H%M%S)" }

# Weather
weather() { curl -s "wttr.in/${1:-Brussels}?format=3" }

# Cheat sheet
cheat() { curl -s "cheat.sh/$1" }

# Port check
port() { lsof -i :"$1" }
ports() { lsof -i -P -n | grep LISTEN }

# Kill process on port
killport() { lsof -ti :"$1" | xargs kill -9 }

# Delete the previously checked-out git branch (with confirmation)
gitremoveprev() {
  local prev=$(git rev-parse --abbrev-ref @{-1} 2>/dev/null)
  [[ -z "$prev" ]] && { echo "No previous branch found."; return 1; }
  read "confirm?Delete branch '$prev'? [y/N] " && [[ $confirm == [yY] ]] && git branch -D "$prev"
}

